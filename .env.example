# --- LLM provider (Groq free tier, open-weight model) ---
MODEL_PROVIDER=groq
MODEL_NAME=qwen/qwen3.8-27b
GROQ_API_KEY=

# --- Reddit (optional, disabled unless all three are set) ---
# Reddit closed self-service OAuth app registration in late 2025.
# New apps require manual review (2-4 weeks). Leave blank to run
# the agent on Hacker News + Stack Exchange only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=grounded-research-agent/0.1 by <your-reddit-username>

# --- Stack Exchange (optional but recommended: raises the free quota
# from 300 req/day anonymous to 10,000 req/day with a registered key) ---
STACKEXCHANGE_KEY=

# --- LangSmith tracing (free Developer plan) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=grounded-research-agent
